# 《通用提交材料说明》第三章：统一 LF 换行，二进制文件标 binary
* text=auto eol=lf

# Shell 脚本保持 LF，Windows PowerShell 脚本保持 CRLF（UTF-8 BOM 由文件本身携带）；后写的规则覆盖上面的默认
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# 赛题数据包、图片、模型权重与离线包：禁止换行转换与 diff
*.sqlite binary
*.xlsx   binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.onnx   binary
*.whl    binary
*.zip    binary
*.gz     binary
